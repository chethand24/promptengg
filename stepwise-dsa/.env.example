# Keep free demos enabled; custom code automatically uses the selected provider when the key and model are configured.
MOCK_LLM=true
PORT=3001
CORS_ORIGIN=http://localhost:5173
SANDBOX_ENABLED=false
SESSION_DIR=.sessions
LLM_PROVIDER=openrouter
LLM_MODEL=openrouter/free
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

